-- [[ WIZARD SKIP — single sound, no lingering frame, no gap ]]

task.spawn(function()
	local TweenService = game:GetService("TweenService")
	local Players = game:GetService("Players")
	local SoundService = game:GetService("SoundService")
	local RunService = game:GetService("RunService")

	local player = Players.LocalPlayer
	local pg = player:WaitForChild("PlayerGui", 30)

	local sg
	local elapsed = 0
	while elapsed < 60 do
		sg = pg:FindFirstChild("BloxyParadoxProject")
		if sg then break end
		task.wait(0.2)
		elapsed = elapsed + 0.2
	end
	if not sg then
		warn("[Wizard Skip] GUI never appeared.")
		return
	end

	local clickSfx = Instance.new("Sound")
	clickSfx.SoundId = "rbxassetid://12221967"
	clickSfx.Volume = 0.6
	clickSfx.Parent = SoundService
	local function playClick() clickSfx:Stop() clickSfx:Play() end

	local function isMaterialsFrame(obj)
		if not obj or typeof(obj) ~= "Instance" then return false end
		if not obj:IsA("GuiObject") then return false end
		local found = false
		pcall(function()
			for _, d in ipairs(obj:GetDescendants()) do
				if d:IsA("TextLabel")
				   and type(d.Text) == "string"
				   and d.Text:lower():find("old materials", 1, true) then
					found = true
					return
				end
			end
		end)
		return found
	end

	local function getUpvalue(fn, targetName)
		if type(fn) ~= "function" then return nil end
		if not debug or not debug.getupvalue then return nil end
		local i = 1
		while true do
			local ok, name, value = pcall(debug.getupvalue, fn, i)
			-- Most executors return only the value, so names can't be matched.
			if not ok or type(name) ~= "string" then break end
			if name == targetName then return value end
			i = i + 1
		end
		return nil
	end

	local function getClickHandler(btn)
		if not btn or not getconnections then return nil end
		local ok, conns = pcall(getconnections, btn.MouseButton1Click)
		if not ok or type(conns) ~= "table" then return nil end
		for _, conn in ipairs(conns) do
			if conn.Function then return conn.Function end
		end
		return nil
	end

	local function getScriptOf(fn)
		if type(fn) ~= "function" or not getfenv then return nil end
		local ok, env = pcall(getfenv, fn)
		if ok and type(env) == "table" and typeof(env.script) == "Instance" then
			return env.script
		end
		return nil
	end

	local function fireClick(btn)
		if not btn or not btn.Parent then return end
		if firesignal then
			if pcall(firesignal, btn.MouseButton1Click) then return end
		end
		pcall(function() btn.MouseButton1Click:Fire() end)
	end

	-- While "rushing", the wizard's own waits are cut to a single frame and its
	-- tween delays to 0. The game waits out the (now invisible) materials
	-- prompt's slide-out before showing the forcefield prompt, and that wait
	-- is the empty gap.
	local rush = { active = false, script = nil, startedAt = 0, endAt = nil }

	local function rushing()
		if not rush.active then return false end
		if not rush.script or not getcallingscript then return true end
		local ok, caller = pcall(getcallingscript)
		return ok and caller == rush.script
	end

	local function startRush(fn)
		rush.script = getScriptOf(fn)
		rush.startedAt = os.clock()
		rush.endAt = nil
		rush.active = true
	end

	if hookfunction then
		local ok, err = pcall(function()
			-- hookfunction returns the original; calling the hooked function
			-- from inside the wrapper would recurse into the wrapper.
			local oldCreate
			local createWrapper = function(self, obj, tweenInfo, goal)
				if typeof(tweenInfo) == "TweenInfo" then
					local materials = isMaterialsFrame(obj)
					if (materials and (tweenInfo.Time > 0 or tweenInfo.DelayTime > 0))
					   or (rushing() and tweenInfo.DelayTime > 0) then
						tweenInfo = TweenInfo.new(
							materials and 0 or tweenInfo.Time,
							tweenInfo.EasingStyle,
							tweenInfo.EasingDirection,
							tweenInfo.RepeatCount,
							tweenInfo.Reverses,
							0
						)
					end
				end
				return oldCreate(self, obj, tweenInfo, goal)
			end
			if newcclosure then createWrapper = newcclosure(createWrapper) end
			oldCreate = hookfunction(TweenService.Create, createWrapper)

			-- A rushed wait still yields one frame so loops can't spin forever.
			local oldTaskWait
			local taskWaitWrapper = function(t)
				if rushing() then return oldTaskWait() end
				return oldTaskWait(t)
			end
			if newcclosure then taskWaitWrapper = newcclosure(taskWaitWrapper) end
			oldTaskWait = hookfunction(task.wait, taskWaitWrapper)

			local oldTaskDelay
			local taskDelayWrapper = function(t, ...)
				if rushing() then return oldTaskDelay(0, ...) end
				return oldTaskDelay(t, ...)
			end
			if newcclosure then taskDelayWrapper = newcclosure(taskDelayWrapper) end
			oldTaskDelay = hookfunction(task.delay, taskDelayWrapper)

			local legacyWait = (getrenv and getrenv().wait) or wait
			local oldWait
			local waitWrapper = function(t)
				if rushing() then return oldWait() end
				return oldWait(t)
			end
			if newcclosure then waitWrapper = newcclosure(waitWrapper) end
			oldWait = hookfunction(legacyWait, waitWrapper)
		end)
		if ok then
			print("[Wizard Skip] Hooks installed.")
		else
			warn("[Wizard Skip] Hooking failed: " .. tostring(err))
		end
	else
		warn("[Wizard Skip] hookfunction unavailable — gap can't be removed.")
	end

	local handled = setmetatable({}, {__mode = "k"})

	local function skipFrame(frame)
		if handled[frame] or not frame:IsA("Frame") or not isMaterialsFrame(frame) then return end
		handled[frame] = true

		pcall(function()
			frame.Visible = false
			frame.Position = UDim2.new(0, 0, 0, -9999)
		end)

		local noBtn
		for _, d in ipairs(frame:GetDescendants()) do
			if d:IsA("TextButton") and d.Text == "No" then
				noBtn = d
				break
			end
		end

		if not noBtn then
			print("[Wizard Skip] No button not found.")
			return
		end

		local handler = getClickHandler(noBtn)
		local showFF = handler and getUpvalue(handler, "showForcefieldUI")
		local onMats = handler and getUpvalue(handler, "OnMaterialsSelected")

		if type(showFF) == "function" and type(onMats) == "function" then
			print("[Wizard Skip] Fast path.")
			startRush(showFF)
			task.spawn(showFF)
			task.spawn(pcall, onMats, false)
			playClick()
			pcall(function() frame:Destroy() end)
		else
			print("[Wizard Skip] Fallback — firing No.")
			startRush(handler)
			fireClick(noBtn)
		end
	end

	-- React the moment the frame (or its question text) shows up instead of
	-- waiting for the next render step.
	sg.ChildAdded:Connect(function(child)
		skipFrame(child)
		if not child:IsA("Frame") then return end
		if rush.active and not handled[child] and not rush.endAt then
			-- The next prompt arrived; let its slide-in tween get created, then stop.
			rush.endAt = os.clock() + 0.15
			print(string.format("[Wizard Skip] Next prompt after %.2fs.", os.clock() - rush.startedAt))
		end
		if handled[child] then return end
		local conn
		conn = child.DescendantAdded:Connect(function(d)
			if d:IsA("TextLabel") then
				task.defer(skipFrame, child)
				d:GetPropertyChangedSignal("Text"):Connect(function()
					skipFrame(child)
				end)
			end
			if handled[child] then conn:Disconnect() end
		end)
	end)

	RunService.RenderStepped:Connect(function()
		if rush.active then
			local now = os.clock()
			if (rush.endAt and now >= rush.endAt) or now - rush.startedAt > 2 then
				rush.active = false
			end
		end

		if not sg or not sg.Parent then return end

		for _, frame in ipairs(sg:GetChildren()) do
			skipFrame(frame)
		end
	end)

	print("[Wizard Skip] Watching.")
end)
